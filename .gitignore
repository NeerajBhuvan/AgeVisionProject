# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/
*.so
venv/
env/
.env

# Model checkpoints (too large for GitHub)
*.pth
*.pt
*.h5
*.onnx
*.pkl
*.dat
*.caffemodel
agevision_backend/checkpoints/

# Node
node_modules/
agevision-frontend/.angular/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Django
*.sqlite3
agevision_backend/media/
db.sqlite3

# Results/output
results/

# Logs
*.log

# Temp
*.tmp
.claude/

# Secrets/tokens
*_token.txt
*.secret
credentials*.json
# Cloud Run env file holds the real SECRET_KEY + Mongo password — never commit
cloudrun-env.yaml
# Local-demo env file (Modal endpoints + local secrets)
.env.local

# Large binary files
*.zip
*.tar.gz
*.rar

# Images and generated reports (not app assets)
images/
age_vision_logo.png
*.pdf
report.html
agevision_complete.html

# Datasets
agevision_backend/datasets/
datasets/

# Django collectstatic output — regenerate with: manage.py collectstatic
agevision_backend/staticfiles/

# WinSW service wrapper binary (re-downloadable third-party exe); keep .xml/.bat
service/*.exe

# Pip install artifacts
=*

# Scripts not part of core app
download_samples.py

# Jupyter notebooks (training)
sam-finetune.ipynb

# Generated Word/report documents (thesis folder excluded from this rule)
*.docx
!thesis/*.docx
!thesis/*.pdf

# Google Drive uploader artifacts
gdrive_token.json
gdrive_client_secrets.json
fading_model.zip

# Report generation assets (not app assets)
screenshots/
anna_university_logo.png
