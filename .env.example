# ─────────────────────────────────────────────────────────
# AgeVisionProject — Environment Variables
# Copy this file to agevision_backend/.env and fill in values
# ─────────────────────────────────────────────────────────

# Django Core
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
# Comma-separated; include your Cloud Run service URL and Firebase hosting domain
ALLOWED_HOSTS=your-cloudrun-hash-uc.a.run.app,your-firebase-app.web.app,localhost

# MongoDB Atlas (get from atlas.mongodb.com → Connect → Drivers)
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/agevision_db?retryWrites=true&w=majority

# CORS — Angular frontend origin(s), comma-separated
# Firebase Hosting URL + localhost for local dev
CORS_ORIGINS=https://your-firebase-app.web.app,http://localhost:4200

# FADING Diffusion GPU (Modal.com)
# Run: cd agevision_backend/agevision_api/diffusion_aging && modal deploy modal_app.py
# Then paste the printed endpoint URL here
FADING_MODAL_ENDPOINT=https://your-modal-app--agevision-fading-age-face-endpoint.modal.run

# ── Optional overrides (only needed if NOT using MONGO_URI above) ──
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_DB=agevision_db
